# ── Build frontend ───────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .

# No VITE_API_URL → defaults to '' (same-origin, Caddy proxies /api)
RUN npm run build

# ── Caddy serves static + proxies API ───────────────────────
FROM caddy:2-alpine

COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /app/dist /srv

EXPOSE 80 443
