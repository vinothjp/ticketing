generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum FieldVisibility {
  VISIBLE
  HIDDEN
}

enum FieldRequirement {
  MANDATORY
  OPTIONAL
}

model Client {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique
  contactEmail String?
  contactPhone String?
  logoUrl      String?
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String?
  updatedBy    String?
  users        User[]
  roles        Role[]
  license      License?
  templates    Template[]
  picklistOptions PicklistOption[]
  slaPolicies  SlaPolicy[]
  messagingChannels MessagingChannel[]
  tickets      Ticket[]
  customerCompanies CustomerCompany[]
  smtpConfig   SmtpConfig?
  ticketSequence Int @default(0)
}

// An external customer company of the tenant (Client). Each has a handful of
// contact users who log in and raise tickets; agents see and filter by company.
model CustomerCompany {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  code         String?
  contactEmail String?
  status       String   @default("ACTIVE")
  maxContacts  Int      @default(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  users        User[]
  tickets      Ticket[]

  @@unique([clientId, name])
}

model License {
  id         String        @id @default(uuid())
  clientId   String        @unique
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan       String
  maxUsers   Int
  startDate  DateTime
  expiryDate DateTime
  status     LicenseStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  createdBy  String?
  updatedBy  String?
}

model User {
  id             String      @id @default(uuid())
  username       String      @unique
  email          String      @unique
  passwordHash   String
  isActive       Boolean     @default(true)
  resetToken     String?
  resetTokenExp  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  updatedBy      String?
  clientId       String?
  client         Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Set for external customer-contact users; null for internal staff/agents.
  customerCompanyId String?
  customerCompany   CustomerCompany? @relation(fields: [customerCompanyId], references: [id], onDelete: SetNull)
  userRoles      UserRole[]
  ticketAssignments TicketTechnician[]
}

model Role {
  id               String            @id @default(uuid())
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userRoles        UserRole[]
  formPermissions  FormPermission[]

  @@unique([clientId, name])
}

model AppForm {
  id               String            @id @default(uuid())
  name             String            @unique
  displayName      String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?
  formPermissions  FormPermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([userId, roleId])
}

model SmtpConfig {
  id                String   @id @default(uuid())
  // null = the platform-global config (id "global"); set = a tenant's own SMTP.
  clientId          String?  @unique
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  host              String?
  port              Int      @default(587)
  useTls            Boolean  @default(true)
  username          String?
  passwordEncrypted String?
  fromAddress       String?
  enabled           Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  updatedBy         String?
}

model FormPermission {
  id        String   @id @default(uuid())
  roleId    String
  formId    String
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canView   Boolean  @default(false)
  canDelete Boolean  @default(false)
  canExport Boolean  @default(false)
  canImport Boolean  @default(false)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  form      AppForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([roleId, formId])
}

model Template {
  id                  String         @id @default(uuid())
  clientId            String
  client              Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  category            String?
  description         String?
  descriptionGuidance String?
  icon                String?
  color               String?
  defaultPriority     String?
  sortOrder           Int            @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String?
  updatedBy           String?
  fields              TemplateField[]
  tickets             Ticket[]

  @@unique([clientId, name])
}

model TemplateField {
  id                   String           @id @default(uuid())
  templateId           String
  template             Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey             String
  isCustom             Boolean          @default(false)
  label                String?
  dataType             String?
  group                String?
  placeholder          String?
  options              Json?
  visibility           FieldVisibility  @default(HIDDEN)
  requirement          FieldRequirement @default(OPTIONAL)
  readOnly             Boolean          @default(false)
  sortOrder            Int              @default(0)
  helperTextOverride   String?
  defaultValueOverride String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdBy            String?
  updatedBy            String?

  @@unique([templateId, fieldKey])
}

model SlaPolicy {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  priority       String
  responseHours  Int?
  resolutionHours Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?

  @@unique([clientId, priority])
}

model PicklistOption {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  listKey     String
  value       String
  label       String
  parentValue String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  @@unique([clientId, listKey, value])
}

model Ticket {
  id                    String       @id @default(uuid())
  clientId              String
  client                Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ticketNumber          String
  templateId            String
  template              Template     @relation(fields: [templateId], references: [id])

  // Ticket Info
  requestorName         String?
  requestorUserId       String?
  requestorEmail        String?
  customerName          String?
  customerCompanyId     String?
  department             String?
  requestorContact      String?
  priority              String?
  ticketStatus          String
  ticketCategory        String?
  subCategory           String?
  notifyEmails          String[]     @default([])
  dueDate               DateTime?
  expectedResolutionDate DateTime?
  slaHours              Int?
  firstResponseAt       DateTime?
  closedDate            DateTime?

  // Ticket Detail
  subject               String
  description           String

  // Resolution
  resolution            String?
  resolutionCode        String?
  resolvedAt            DateTime?
  resolvedById          String?
  reopenedCount         Int          @default(0)

  // Admin-designed custom fields (keyed by TemplateField.fieldKey)
  customFields          Json         @default("{}")

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  createdBy             String?
  updatedBy             String?

  customerCompany       CustomerCompany? @relation(fields: [customerCompanyId], references: [id])
  technicians           TicketTechnician[]
  attachments           TicketAttachment[]
  activities            TicketActivity[]
  tasks                 TicketTask[]
  approvals             TicketApproval[]
  messages              TicketMessage[]

  @@unique([clientId, ticketNumber])
  @@index([clientId, customerCompanyId])
  @@index([customFields(ops: JsonbOps)], type: Gin)
}

model TicketTechnician {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([ticketId, userId])
}

model TicketAttachment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
  uploadedBy String?
}

// Audit trail / activity timeline (History tab)
model TicketActivity {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorName   String?
  type        String
  summary     String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
}

// Sub-tasks (Tasks tab)
model TicketTask {
  id             String    @id @default(uuid())
  ticketId       String
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assigneeUserId String?
  assigneeName   String?
  status         String    @default("OPEN")
  dueDate        DateTime?
  sortOrder      Int       @default(0)
  completedAt    DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ticketId])
}

// Approvals (Approvals tab)
model TicketApproval {
  id             String    @id @default(uuid())
  ticketId       String
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approverUserId String
  approverName   String?
  status         String    @default("PENDING")
  comment        String?
  requestedById  String?
  requestedByName String?
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  level          Int       @default(1)

  @@index([ticketId])
}

// Conversation messages (email + internal notes)
model TicketMessage {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  channel      String   @default("EMAIL")
  direction    String   @default("OUTBOUND")
  isInternal   Boolean  @default(false)
  authorUserId String?
  authorName   String?
  fromAddress  String?
  toAddress    String?
  subject      String?
  body         String
  htmlBody     String?
  externalId   String?
  status       String   @default("SENT")
  error        String?
  createdAt    DateTime @default(now())

  attachments  MessageAttachment[]

  @@index([ticketId, createdAt])
  @@index([externalId])
}

model MessageAttachment {
  id        String        @id @default(uuid())
  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  mimeType  String
  size      Int
}

// Per-client messaging channel config (IMAP inbox now; reusable for WhatsApp/SMS later)
model MessagingChannel {
  id              String   @id @default(uuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type            String
  provider        String   @default("imap")
  configEncrypted String?
  fromIdentity    String?
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@unique([clientId, type])
}
