# ── Database ─────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=rbac_db

# ── Auth secrets (generate with: openssl rand -base64 32) ───
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption key for SMTP configs etc ─────────────────────
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_EXACTLY_HERE!

# ── Site address ────────────────────────────────────────────
# Domain with auto-SSL:   SITE_ADDRESS=tickets.example.com
# IP-only (plain HTTP):   SITE_ADDRESS=:80
# IP with specific addr:  SITE_ADDRESS=192.168.1.50:80
SITE_ADDRESS=:80

# ── Ports (change if 80/443 are taken) ─────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── CORS (usually not needed behind Caddy — same origin) ───
# CORS_ORIGINS=https://tickets.example.com

# ── SuperAdmin 2FA (OTP service) ───────────────────────────
# Shared secret between backend and OTP service (generate with: openssl rand -base64 32)
OTP_API_KEY=CHANGE_ME_OTP_KEY

# SMTP for OTP emails (separate from the app's built-in SMTP)
OTP_SMTP_HOST=smtp.gmail.com
OTP_SMTP_PORT=587
OTP_SMTP_USER=your-otp-sender@gmail.com
OTP_SMTP_PASS=your-app-password
OTP_SMTP_FROM=noreply@yourcompany.com

# ── First run only — seeds admin user ──────────────────────
# Set to true on first deploy, then remove or set false
RUN_SEED=true
