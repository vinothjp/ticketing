generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum FieldVisibility {
  VISIBLE
  HIDDEN
}

enum FieldRequirement {
  MANDATORY
  OPTIONAL
}

model Client {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique
  contactEmail String?
  contactPhone String?
  logoUrl      String?
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String?
  updatedBy    String?
  users        User[]
  roles        Role[]
  license      License?
  templates    Template[]
  picklistOptions PicklistOption[]
  slaPolicies  SlaPolicy[]
  messagingChannels MessagingChannel[]
  tickets      Ticket[]
  customerCompanies CustomerCompany[]
  smtpConfig   SmtpConfig?
  kbArticles   KbArticle[]
  projects     Project[]
  resourceCategories ResourceCategory[]
  ticketSequence Int @default(0)
  kbSequence   Int @default(0)
  projectSequence Int @default(0)
}

// Knowledge base article. Staff author; customers see published + customer-visible ones.
model KbArticle {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentNumber String?
  articleType   String   @default("KNOWLEDGE")  // KNOWLEDGE | PROBLEM
  title         String
  category      String?
  subCategory   String?
  module        String?
  subject       String?
  versionNumber String?
  body          String                          // "Content"
  problemDescription String?
  resolution    String?
  cause         String?
  prevention    String?
  keywords      String[] @default([])
  urlReferences Json     @default("[]")          // [{ label?, url }]
  status        String   @default("DRAFT")       // DRAFT | PUBLISHED
  audience      String   @default("INTERNAL")    // INTERNAL | CUSTOMER
  knowledgeOwnerId   String?
  knowledgeOwnerName String?
  publishedDate DateTime?
  expiryDate    DateTime?
  createdBy     String?
  createdByName String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  attachments   KbAttachment[]

  @@index([clientId, status])
}

model KbAttachment {
  id         String    @id @default(uuid())
  articleId  String
  article    KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  mimeType   String
  size       Int
  uploadedAt DateTime  @default(now())
  uploadedBy String?
}

// An external customer company of the tenant (Client). Each has a handful of
// contact users who log in and raise tickets; agents see and filter by company.
model CustomerCompany {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  code         String?
  contactEmail String?
  status       String   @default("ACTIVE")
  maxContacts  Int      @default(5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  users        User[]
  tickets      Ticket[]
  projects     Project[]

  @@unique([clientId, name])
}

model License {
  id         String        @id @default(uuid())
  clientId   String        @unique
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan       String
  maxUsers   Int
  startDate  DateTime
  expiryDate DateTime
  status     LicenseStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  createdBy  String?
  updatedBy  String?
}

model User {
  id             String      @id @default(uuid())
  username       String      @unique
  email          String      @unique
  passwordHash   String
  isActive       Boolean     @default(true)
  resetToken     String?
  resetTokenExp  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  updatedBy      String?
  clientId       String?
  client         Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Set for external customer-contact users; null for internal staff/agents.
  customerCompanyId String?
  customerCompany   CustomerCompany? @relation(fields: [customerCompanyId], references: [id], onDelete: SetNull)
  userRoles      UserRole[]
  ticketAssignments TicketTechnician[]
  projectTaskWatchers ProjectTaskWatcher[]
  projectResources ProjectResource[]
  projectTimesheets ProjectTimesheet[]
}

model Role {
  id               String            @id @default(uuid())
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userRoles        UserRole[]
  formPermissions  FormPermission[]

  @@unique([clientId, name])
}

model AppForm {
  id               String            @id @default(uuid())
  name             String            @unique
  displayName      String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?
  formPermissions  FormPermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([userId, roleId])
}

model SmtpConfig {
  id                String   @id @default(uuid())
  // null = the platform-global config (id "global"); set = a tenant's own SMTP.
  clientId          String?  @unique
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  host              String?
  port              Int      @default(587)
  useTls            Boolean  @default(true)
  username          String?
  passwordEncrypted String?
  fromAddress       String?
  enabled           Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  updatedBy         String?
}

model FormPermission {
  id        String   @id @default(uuid())
  roleId    String
  formId    String
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canView   Boolean  @default(false)
  canDelete Boolean  @default(false)
  canExport Boolean  @default(false)
  canImport Boolean  @default(false)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  form      AppForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([roleId, formId])
}

model Template {
  id                  String         @id @default(uuid())
  clientId            String
  client              Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  category            String?
  description         String?
  descriptionGuidance String?
  icon                String?
  color               String?
  defaultPriority     String?
  sortOrder           Int            @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String?
  updatedBy           String?
  fields              TemplateField[]
  tickets             Ticket[]

  @@unique([clientId, name])
}

model TemplateField {
  id                   String           @id @default(uuid())
  templateId           String
  template             Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey             String
  isCustom             Boolean          @default(false)
  label                String?
  dataType             String?
  group                String?
  placeholder          String?
  options              Json?
  visibility           FieldVisibility  @default(HIDDEN)
  requirement          FieldRequirement @default(OPTIONAL)
  readOnly             Boolean          @default(false)
  sortOrder            Int              @default(0)
  helperTextOverride   String?
  defaultValueOverride String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdBy            String?
  updatedBy            String?

  @@unique([templateId, fieldKey])
}

model SlaPolicy {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  priority       String
  responseHours  Int?
  resolutionHours Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?

  @@unique([clientId, priority])
}

model PicklistOption {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  listKey     String
  value       String
  label       String
  parentValue String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  @@unique([clientId, listKey, value])
}

model Ticket {
  id                    String       @id @default(uuid())
  clientId              String
  client                Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ticketNumber          String
  templateId            String
  template              Template     @relation(fields: [templateId], references: [id])
  projectId             String?
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Ticket Info
  requestorName         String?
  requestorUserId       String?
  requestorEmail        String?
  customerName          String?
  customerCompanyId     String?
  department             String?
  requestorContact      String?
  priority              String?
  ticketStatus          String
  ticketCategory        String?
  subCategory           String?
  notifyEmails          String[]     @default([])
  dueDate               DateTime?
  expectedResolutionDate DateTime?
  slaHours              Int?
  firstResponseAt       DateTime?
  closedDate            DateTime?

  // Ticket Detail
  subject               String
  description           String

  // Resolution
  resolution            String?
  resolutionCode        String?
  resolvedAt            DateTime?
  resolvedById          String?
  reopenedCount         Int          @default(0)

  // Admin-designed custom fields (keyed by TemplateField.fieldKey)
  customFields          Json         @default("{}")

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  createdBy             String?
  updatedBy             String?

  customerCompany       CustomerCompany? @relation(fields: [customerCompanyId], references: [id])
  technicians           TicketTechnician[]
  attachments           TicketAttachment[]
  activities            TicketActivity[]
  tasks                 TicketTask[]
  approvals             TicketApproval[]
  messages              TicketMessage[]

  @@unique([clientId, ticketNumber])
  @@index([clientId, customerCompanyId])
  @@index([clientId, projectId])
  @@index([customFields(ops: JsonbOps)], type: Gin)
}

model TicketTechnician {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([ticketId, userId])
}

model TicketAttachment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
  uploadedBy String?
}

// Audit trail / activity timeline (History tab)
model TicketActivity {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorName   String?
  type        String
  summary     String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
}

// Sub-tasks (Tasks tab)
model TicketTask {
  id             String    @id @default(uuid())
  ticketId       String
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assigneeUserId String?
  assigneeName   String?
  status         String    @default("OPEN")
  dueDate        DateTime?
  sortOrder      Int       @default(0)
  completedAt    DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ticketId])
}

// Approvals (Approvals tab)
model TicketApproval {
  id             String    @id @default(uuid())
  ticketId       String
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approverUserId String
  approverName   String?
  status         String    @default("PENDING")
  comment        String?
  requestedById  String?
  requestedByName String?
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  level          Int       @default(1)

  @@index([ticketId])
}

// Conversation messages (email + internal notes)
model TicketMessage {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  channel      String   @default("EMAIL")
  direction    String   @default("OUTBOUND")
  isInternal   Boolean  @default(false)
  authorUserId String?
  authorName   String?
  fromAddress  String?
  toAddress    String?
  subject      String?
  body         String
  htmlBody     String?
  externalId   String?
  status       String   @default("SENT")
  error        String?
  createdAt    DateTime @default(now())

  attachments  MessageAttachment[]

  @@index([ticketId, createdAt])
  @@index([externalId])
}

model MessageAttachment {
  id        String        @id @default(uuid())
  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  mimeType  String
  size      Int
}

// Per-client messaging channel config (IMAP inbox now; reusable for WhatsApp/SMS later)
model MessagingChannel {
  id              String   @id @default(uuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type            String
  provider        String   @default("imap")
  configEncrypted String?
  fromIdentity    String?
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@unique([clientId, type])
}

// A project groups work (tasks, milestones) and can link related tickets.
model Project {
  id                String   @id @default(uuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectNumber     String
  name              String
  key               String?                              // short code, e.g. "WEB"
  projectCode       String?                              // Excel "Project Code"
  description       String?
  status            String   @default("OPEN")            // OPEN | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  priority          String?                              // LOW | MEDIUM | HIGH | URGENT
  managerUserId     String?
  managerName       String?
  projectSponsor    String?
  department        String?
  budget            Decimal?
  currency          String?
  projectType       String?
  startDate         DateTime?
  endDate           DateTime?
  goLiveDate        DateTime?
  // Project overview (Excel)
  objective         String?
  scope             String?
  outOfScope        String?
  successCriteria   String?
  customerCompanyId String?
  customerCompany   CustomerCompany? @relation(fields: [customerCompanyId], references: [id], onDelete: SetNull)
  createdBy         String?
  createdByName     String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  taskSequence      Int      @default(0)          // powers per-project task keys (KEY-#)
  features          Json     @default("{}")        // feature toggles: { timeTracking, sprints, cascadingDates }
  milestones        ProjectMilestone[]
  sprints           ProjectSprint[]
  tasks             ProjectTask[]
  resources         ProjectResource[]
  timesheets        ProjectTimesheet[]
  risks             ProjectRisk[]
  issues            ProjectIssue[]
  changeRequests    ProjectChangeRequest[]
  meetings          ProjectMeeting[]
  documents         ProjectDocument[]
  expenses          ProjectExpense[]
  invoices          ProjectInvoice[]
  attachments       ProjectAttachment[]
  tickets           Ticket[]

  @@unique([clientId, projectNumber])
  @@index([clientId, status])
}

// Generic attachments (file upload OR pasted link) for any project sub-entity
// (invoice / document / risk / issue / …), scoped by entityType + entityId.
model ProjectAttachment {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityType String                                       // invoice | document | risk | issue | …
  entityId   String
  fileName   String?
  filePath   String?                                      // /uploads/projects/… for uploaded files
  mimeType   String?
  size       Int?
  url        String?                                      // external link (when not an uploaded file)
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([projectId, entityType, entityId])
}

// --- Governance registers (Excel: Risks / Issues / Change Requests / Approvals / MoM / Deadlines / Documents) ---

model ProjectRisk {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  probability String   @default("MEDIUM")             // LOW | MEDIUM | HIGH
  impact      String   @default("MEDIUM")             // LOW | MEDIUM | HIGH
  mitigation  String?
  ownerName   String?
  status      String   @default("OPEN")               // OPEN | MITIGATED | CLOSED
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model ProjectIssue {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  priority    String?                                  // LOW | MEDIUM | HIGH | URGENT
  ownerName   String?
  targetDate  DateTime?
  resolution  String?
  status      String   @default("OPEN")               // OPEN | IN_PROGRESS | RESOLVED
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model ProjectChangeRequest {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  reason         String?
  scheduleImpact String?
  costEstimate   Decimal?                                // cost of the change (auto-suggested from linked tasks, overridable)
  budgetImpact   Decimal?                                // approved budget increase applied to the baseline on approval
  status         String   @default("SUBMITTED")        // DRAFT | SUBMITTED | PENDING_CUSTOMER | CUSTOMER_APPROVED | APPROVED | REJECTED
  requestedBy    String?
  decidedAt      DateTime?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tasks          ProjectTask[]                           // WBS tasks this change request introduced

  @@index([projectId])
}

model ProjectMeeting {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime?
  attendees   String?
  notes       String?
  actionItems Json     @default("[]")                  // [{ text, owner?, due?, done? }]
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model ProjectDocument {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docType       String?
  name          String
  versionNumber String?
  fileName      String?
  filePath      String?
  mimeType      String?
  size          Int?
  uploadedBy    String?
  uploadedAt    DateTime @default(now())

  @@index([projectId])
}

// Project expense (Excel "Expenses"): categorised spend.
model ProjectExpense {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String                                   // Consultant Cost | Travel | Accommodation | Food | Hardware | Software | Cloud | Third Party | Training | Other
  description String?
  amount      Decimal  @default(0)
  date        DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// Customer invoice (Excel "Billing").
model ProjectInvoice {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber String
  invoiceDate   DateTime?
  amount        Decimal  @default(0)
  amountPaid    Decimal  @default(0)
  type          String?                                // Fixed Price | Time & Material | AMC | Internal
  status        String   @default("DRAFT")             // DRAFT | SENT | PAID
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

// Tenant cost catalog: a resource category with cost & billing rates (Excel "Resources Cost").
model ResourceCategory {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String                                  // e.g. Sr Developer / Jr Developer / Project Manager
  hourlyCost  Decimal  @default(0)
  billingRate Decimal  @default(0)
  dailyHours  Int      @default(8)
  isActive    Boolean  @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resources   ProjectResource[]

  @@unique([clientId, name])
}

// A consultant allocated to a project (Excel "Resources Plan").
model ProjectResource {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  consultantName String?
  categoryId     String?
  category       ResourceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  role           String?
  allocationPct  Int      @default(100)
  dailyHours     Int      @default(8)
  startDate      DateTime?
  endDate        DateTime?
  billable       Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
}

// A timesheet entry against a project / WBS activity (Excel "Project Time Sheet").
model ProjectTimesheet {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  consultantName String?
  date           DateTime
  taskId         String?
  activity       String?
  hours          Decimal  @default(0)
  workPerformed  String?
  status         String   @default("SUBMITTED")       // DRAFT | SUBMITTED | APPROVED | REJECTED
  documentNumber String?                                // Excel "Document Number" (per consultant/week sheet)
  documentDate   DateTime?                              // Excel "Document Date" (= week start)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, date])
  @@index([userId, date])
}

// An agile sprint: a time-boxed set of tasks pulled from the backlog.
model ProjectSprint {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  goal       String?
  status     String   @default("PLANNED")          // PLANNED | ACTIVE | COMPLETED
  startDate  DateTime?
  endDate    DateTime?
  sortOrder  Int      @default(0)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tasks      ProjectTask[]

  @@index([projectId])
}

// A project milestone / stage gate (Excel grouping). Tasks are grouped by milestone;
// its % complete is computed from member tasks. Seeded with 8 defaults per project.
model ProjectMilestone {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  status     String   @default("PENDING")          // PENDING | IN_PROGRESS | COMPLETED
  targetDate DateTime?
  sortOrder  Int      @default(0)
  // Stage-gate sign-off (folded in from the former Approvals register).
  approverName    String?
  approvalStatus  String   @default("PENDING")      // PENDING | APPROVED | REJECTED
  decidedAt       DateTime?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tasks      ProjectTask[]

  @@index([projectId])
}

// A WBS node within a project: Phase → Task → Sub Task → Activity → Checklist.
model ProjectTask {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId    String?
  milestone      ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  sprintId       String?
  sprint         ProjectSprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  storyPoints    Int?
  taskNumber     Int?                                    // sequential within project → key = project.key + '-' + taskNumber
  // WBS
  wbsType        String    @default("TASK")             // PHASE | TASK | SUBTASK | ACTIVITY | CHECKLIST | MILESTONE
  wbsCode        String?                                 // auto "1.2.3"
  durationDays   Int?                                    // leaf value; parent = sum of children (computed)
  completionPct  Int       @default(0)                   // 0–100
  actualStart    DateTime?
  actualFinish   DateTime?
  estimatedHours Int?
  actualHours    Int?
  critical       Boolean   @default(false)
  type           String    @default("TASK")             // legacy: TASK | MILESTONE (kept for compatibility)
  title          String
  description    String?
  assigneeUserId String?
  assigneeName   String?
  status         String    @default("TODO")             // TODO | IN_PROGRESS | REVIEW | COMPLETED
  priority       String?
  startDate      DateTime?
  dueDate        DateTime?
  plannedEffort  Int?                                    // hours (supports Gantt later)
  parentTaskId   String?
  parentTask     ProjectTask?  @relation("ProjectTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks       ProjectTask[] @relation("ProjectTaskSubtasks")
  changeRequestId String?                                 // the CR that introduced this task (scope change)
  changeRequest  ProjectChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  tags           String[]  @default([])
  sortOrder      Int       @default(0)
  completedAt    DateTime?
  createdBy      String?
  createdByName  String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  comments       ProjectTaskComment[]
  watchers       ProjectTaskWatcher[]
  successors     ProjectTaskDependency[] @relation("TaskAsPredecessor") // rows where this task is the predecessor
  predecessors   ProjectTaskDependency[] @relation("TaskAsSuccessor")   // rows where this task is the successor

  @@index([projectId, status])
  @@index([changeRequestId])
}

// A comment on a task (supports @mentions stored as plain text in the body).
model ProjectTaskComment {
  id           String   @id @default(uuid())
  taskId       String
  task         ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorUserId String?
  authorName   String?
  body         String
  createdAt    DateTime @default(now())

  @@index([taskId, createdAt])
}

// A user watching a task (notified on updates, mirrors ticket watchers).
model ProjectTaskWatcher {
  id      String   @id @default(uuid())
  taskId  String
  task    ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId  String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([taskId, userId])
}

// A dependency: the successor task cannot start until the predecessor completes.
model ProjectTaskDependency {
  id            String @id @default(uuid())
  predecessorId String
  successorId   String
  predecessor   ProjectTask @relation("TaskAsPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     ProjectTask @relation("TaskAsSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
}
