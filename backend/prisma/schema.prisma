generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum FieldVisibility {
  VISIBLE
  HIDDEN
}

enum FieldRequirement {
  MANDATORY
  OPTIONAL
}

model Client {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique
  contactEmail String?
  contactPhone String?
  logoUrl      String?
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String?
  updatedBy    String?
  users        User[]
  roles        Role[]
  license      License?
  templates    Template[]
  picklistOptions PicklistOption[]
  slaPolicies  SlaPolicy[]
  tickets      Ticket[]
  ticketSequence Int @default(0)
}

model License {
  id         String        @id @default(uuid())
  clientId   String        @unique
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan       String
  maxUsers   Int
  startDate  DateTime
  expiryDate DateTime
  status     LicenseStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  createdBy  String?
  updatedBy  String?
}

model User {
  id             String      @id @default(uuid())
  username       String      @unique
  email          String      @unique
  passwordHash   String
  isActive       Boolean     @default(true)
  resetToken     String?
  resetTokenExp  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  updatedBy      String?
  clientId       String?
  client         Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  ticketAssignments TicketTechnician[]
}

model Role {
  id               String            @id @default(uuid())
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userRoles        UserRole[]
  formPermissions  FormPermission[]

  @@unique([clientId, name])
}

model AppForm {
  id               String            @id @default(uuid())
  name             String            @unique
  displayName      String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?
  formPermissions  FormPermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([userId, roleId])
}

model SmtpConfig {
  id                String   @id @default("global")
  host              String?
  port              Int      @default(587)
  useTls            Boolean  @default(true)
  username          String?
  passwordEncrypted String?
  fromAddress       String?
  enabled           Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  updatedBy         String?
}

model FormPermission {
  id        String   @id @default(uuid())
  roleId    String
  formId    String
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canView   Boolean  @default(false)
  canDelete Boolean  @default(false)
  canExport Boolean  @default(false)
  canImport Boolean  @default(false)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  form      AppForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([roleId, formId])
}

model Template {
  id                  String         @id @default(uuid())
  clientId            String
  client              Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  category            String?
  description         String?
  descriptionGuidance String?
  icon                String?
  color               String?
  defaultPriority     String?
  sortOrder           Int            @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String?
  updatedBy           String?
  fields              TemplateField[]
  tickets             Ticket[]

  @@unique([clientId, name])
}

model TemplateField {
  id                   String           @id @default(uuid())
  templateId           String
  template             Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey             String
  isCustom             Boolean          @default(false)
  label                String?
  dataType             String?
  group                String?
  placeholder          String?
  options              Json?
  visibility           FieldVisibility  @default(HIDDEN)
  requirement          FieldRequirement @default(OPTIONAL)
  readOnly             Boolean          @default(false)
  sortOrder            Int              @default(0)
  helperTextOverride   String?
  defaultValueOverride String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdBy            String?
  updatedBy            String?

  @@unique([templateId, fieldKey])
}

model SlaPolicy {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  priority       String
  responseHours  Int?
  resolutionHours Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?

  @@unique([clientId, priority])
}

model PicklistOption {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  listKey     String
  value       String
  label       String
  parentValue String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  @@unique([clientId, listKey, value])
}

model Ticket {
  id                    String       @id @default(uuid())
  clientId              String
  client                Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ticketNumber          String
  templateId            String
  template              Template     @relation(fields: [templateId], references: [id])

  // Ticket Info
  requestorName         String?
  requestorUserId       String?
  customerName          String?
  department             String?
  requestorContact      String?
  priority              String?
  ticketStatus          String
  ticketCategory        String?
  subCategory           String?
  notifyEmails          String[]     @default([])
  dueDate               DateTime?
  expectedResolutionDate DateTime?
  slaHours              Int?
  closedDate            DateTime?

  // Ticket Detail
  subject               String
  description           String

  // Admin-designed custom fields (keyed by TemplateField.fieldKey)
  customFields          Json         @default("{}")

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  createdBy             String?
  updatedBy             String?

  technicians           TicketTechnician[]
  attachments           TicketAttachment[]

  @@unique([clientId, ticketNumber])
  @@index([customFields(ops: JsonbOps)], type: Gin)
}

model TicketTechnician {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([ticketId, userId])
}

model TicketAttachment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
  uploadedBy String?
}
